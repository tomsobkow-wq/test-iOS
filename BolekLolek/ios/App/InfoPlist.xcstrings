{
  "sourceLanguage": "en",
  "strings": {
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To read your calendar and add events when you ask."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby czytać Twój kalendarz i dodawać wydarzenia, gdy o to poprosisz."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To find phone numbers when you ask to text or call someone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby znajdować numery telefonów, gdy prosisz o napisanie lub zadzwonienie do kogoś."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To tell you the weather where you are."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby podawać pogodę w miejscu, w którym jesteś."
          }
        }
      }
    }
  },
  "version": "1.0"
}