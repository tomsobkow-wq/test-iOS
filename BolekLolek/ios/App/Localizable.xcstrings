    },
    "Full agent · EU cloud": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełny agent · chmura w UE"
          }
        }
      }
    },
    "Hi, I'm Lolek. I run only on this iPhone and never talk to any server. Try “weather”, “alarm: 06:30” or “note: buy milk”.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cześć, jestem Lolek. Działam tylko na tym iPhonie i nie łączę się z żadnym serwerem. Spróbuj: „pogoda”, „budzik: 06:30” lub „notatka: kupić mleko”."
          }
        }
      }
    },
    "Hi, I'm Bolek. I can act for you on the web and in your apps. This is a demo model for now. Try “weather”, “spending: this_week” or “call: Anna”.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cześć, jestem Bolek. Mogę działać za Ciebie w internecie i w Twoich aplikacjach. Na razie to model demonstracyjny. Spróbuj: „pogoda”, „wydatki: this_week” lub „zadzwoń: Anna”."
          }
        }
      }
    }
  },
  "version": "1.0"
}