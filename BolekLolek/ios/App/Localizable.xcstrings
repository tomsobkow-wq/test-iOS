    "About this email: ": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O tym mailu: "
          }
        }
      }
    },
    "Lolek reads your mail on this iPhone only. Nothing goes to Bolek or any server.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lolek czyta Twoją pocztę tylko na tym iPhonie. Nic nie trafia do Bolka ani na żaden serwer."
          }
        }
      }
    },
    "Hi, I'm Lolek. I run on this iPhone, and your chats and documents never leave it. Ask me about the weather, set an alarm, or text a friend.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cześć, jestem Lolek. Działam na tym iPhonie, a Twoje rozmowy i dokumenty nigdy go nie opuszczają. Zapytaj mnie o pogodę, ustaw budzik albo napisz SMS do znajomego."
          }
        }
      }
    },
    "Events": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzenia"
          }
        }
      }
    },
