      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedz"
          }
        }
      }
    },
    "Summarise this email.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streść ten mail."
          }
        }
      }
