    },
    "Hi, I'm Bolek. I can act for you on the web and in your apps. This is a demo model for now. Try: “send: hello to Anna”.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cześć, jestem Bolek. Mogę działać za Ciebie w internecie i w Twoich aplikacjach. Na razie to model demonstracyjny. Spróbuj: „wyślij: cześć do Anny”."
          }
        }
      }
    },
    "Hi, I'm Lolek. I run only on this iPhone and never talk to any server. Try: “note: buy milk”.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cześć, jestem Lolek. Działam tylko na tym iPhonie i nie łączę się z żadnym serwerem. Spróbuj: „notatka: kupić mleko”."
          }
        }
      }
    },
