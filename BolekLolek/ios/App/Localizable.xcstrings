      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wszystko."
          }
        }
      }
    },
    "Could not reach %@.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z %@."
          }
        }
      }
    },
    "Opening…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwieram…"
          }
        }
      }
    },
