      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz"
          }
        }
      }
    },
    "The original message is quoted below your text.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginalna wiadomość zostanie zacytowana pod Twoim tekstem."
          }
        }
      }
    },
    "Sent from your Gmail, straight from this iPhone.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłane z Twojego Gmaila, prosto z tego iPhone'a."
          }
        }
      }
    },
    "This account is connected for reading only. Reconnect it and allow sending to send from the app.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto jest połączone tylko do czytania. Połącz je ponownie i zezwól na wysyłanie, aby wysyłać z aplikacji."
          }
        }
      }
    },
