          }
        }
      }
    },
    "Could not read mail": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać poczty"
          }
        }
      }
    },
    "No mailbox is connected.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna skrzynka nie jest połączona."
